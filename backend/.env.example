# ── Supabase ──────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service role key (secret, backend only) — Settings → API → service_role
SUPABASE_SECRET_KEY=eyJ...

# JWT secret for HS256 fallback (optional if using JWKS)
# SUPABASE_JWT_SECRET=your-jwt-secret

# JWKS endpoint (defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=

# ── Database ──────────────────────────────────────────────────────────
# Connection pooler (Transaction mode) for runtime queries
DATABASE_URL=postgresql://postgres.ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection for Prisma migrations
DIRECT_URL=postgresql://postgres.ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Supabase Storage ──────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=axtract-documents

# ── Encryption ────────────────────────────────────────────────────────
# Base64-encoded 32-byte master key for AES-256-GCM envelope encryption.
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AXTRACT_MASTER_KEY_BASE64=

# Key version (increment when rotating the master key)
AXTRACT_KEY_VERSION=1
