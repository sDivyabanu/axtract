# Local-only app. Change to true explicitly and start with python serve_local.py.
AXTRACT_LOCAL_NO_AUTH=false
# Optional BASE directory; an isolated local-no-auth/ namespace is always appended.
# AXTRACT_LOCAL_DATA_DIR=
# Smart Benchmark Runner paths/settings remain unchanged (docs/BENCHMARK_RUNNER.md).
# AXTRACT_BENCH_DATA_DIR=
# AXTRACT_BENCH_WORKSPACE=
# AXTRACT_BENCH_SCORER_PYTHON=
# AXTRACT_BENCH_EXTRACT_PYTHON=
# AXTRACT_BENCH_IMPORT_ROOT=

# PDF/image cloud extraction; local restores the existing local/VLM router.
AXTRACT_OCR_PROVIDER=azure
AXTRACT_VLM_OCR=off
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Underlying model identifier is required for custom deployment names and cost estimates.
AXTRACT_AZURE_MODEL=gpt-5.4-mini
AXTRACT_AZURE_MODE=hybrid
AXTRACT_AZURE_DETAIL=original
AXTRACT_AZURE_RENDER_DPI=220
AXTRACT_AZURE_DENSE_DPI=300
AXTRACT_AZURE_MAX_IMAGE_EDGE=4096
AXTRACT_AZURE_MAX_PIXELS=12000000
AXTRACT_AZURE_CROPS=auto
AXTRACT_AZURE_NATIVE_HINT_CHARS=2000
AXTRACT_AZURE_QUALITY_REREADS=1
AXTRACT_AZURE_VERBOSITY=high
AXTRACT_AZURE_MAX_OUTPUT_TOKENS=4096
AXTRACT_AZURE_TIMEOUT_SECONDS=90
AXTRACT_AZURE_DOCUMENT_SECONDS=180
AXTRACT_AZURE_MAX_RETRIES=1
AXTRACT_AZURE_MAX_REQUESTS_PER_PAGE=3
# Per-page estimate cap; run allowance is separate. 0 disables the per-page guard.
AXTRACT_AZURE_MAX_USD_PER_PAGE=0.025
# Override the USD rates per million tokens for non-Global pricing / another model.
# AXTRACT_AZURE_INPUT_PRICE=0.75
# AXTRACT_AZURE_OUTPUT_PRICE=4.50
# Optional stronger model. No fallback requests unless explicitly configured.
# AZURE_OPENAI_FALLBACK_DEPLOYMENT=
# AXTRACT_AZURE_FALLBACK_MODEL=
# AXTRACT_AZURE_FALLBACK_POLICY=errors

# Experimental mini-only controls; legacy/default preserve prior request behavior.
# AXTRACT_AZURE_PROMPT=layout
# AXTRACT_AZURE_REASONING=none
# Accuracy pipeline (defaults shown). AXTRACT_AZURE_PROMPT=legacy restores the earlier prompt and single-block output.
# AXTRACT_AZURE_PROMPT=accuracy        # furniture tags, figure/merged-cell tables, scan note
# AXTRACT_AZURE_SPREAD_SPLIT=1         # read the two pages of a scanned spread separately
# AXTRACT_AZURE_SCAN_REASONING=low     # reasoning effort for scanned/handwritten pages only (default|none|low|...)
# AXTRACT_AZURE_NATIVE_SPELLING=1      # correct near-miss prose words against the visible text layer
# AXTRACT_AZURE_SCAN_ENHANCE=0         # measured worse on held-out scans; off
# AXTRACT_AZURE_SCAN_UPSCALE=1         # measured no gain on held-out scans; off
# AXTRACT_AZURE_SCAN_PROOFREAD=0       # measured worse and ~2x cost on held-out scans; off
# Spreads, rereads and coverage recovery can use several requests per page: allow ~0.06 USD per page and 8192 tokens.
