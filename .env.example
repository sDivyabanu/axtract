# Copy this file to frontend/.env.local (the Next.js frontend reads .env.local).
# Only values prefixed with NEXT_PUBLIC_ are exposed to the browser. Never put secrets here.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The backend currently needs no environment variables.
# Placeholders for later features:
# DATABASE_URL=
# VISION_API_KEY=

# Supabase (login, history, encrypted document storage). Optional: when unset the app
# works exactly as before, without sign-in or history.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon/publishable key is safe for the browser. Never put the service-role key,
# database URLs or the encryption master key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend secrets live in backend/.env (see backend/.env.example).
