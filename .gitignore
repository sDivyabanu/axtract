# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Environment files (commit .env.example only)
.env
.env.*
!.env.example
!backend/.env.example

# Prisma generated
dist/
src/prisma/
prisma-8.md

# Temporary uploads and generated output
backend/uploads/*
!backend/uploads/.gitkeep
output/
generated/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Model weights are fetched by scripts/fetch_models.py, never committed
backend/model_weights/**/*.onnx
reports/previews/
reports/c[0-9]_report.*

# Local app data (RAG database, data-room files, persistent previews)
backend/data/

# Benchmark datasets and scorer repos (large, downloaded locally)
benchmarks/

# RAG model cache (fetched by scripts/setup_rag.sh); keep only the checksum manifest
backend/model_weights/rag/*
!backend/model_weights/rag/MANIFEST.sha256
